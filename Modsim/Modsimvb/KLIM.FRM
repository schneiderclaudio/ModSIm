Attribute VB_Name = "KLIM"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Private CHANGE_FLAG As Integer
Private NEWDATA As ModelData
Private ID As Integer

Private Sub CmdAccept_Click()
  Call MakeNew(CURRMODELDATA(ID))
  Unload KLIM
End Sub

Private Sub CmdCancel_Click()
  Unload KLIM
End Sub

Private Sub Form_Unload(Cancel As Integer)
'*****************************************
  Me.Hide  'Must hide me before doing anything on any other form because I'm modal
  Unload Help  'In case help was called
  'Must unload Sysdata now otherwise it remains loaded and will not initialize properly when next needed.
  'SYSDATA was interogated by this form.
  Unload Sysdata
  If FastParameterChange Then
    UnitMods.cmdQuit_Click
    FastParameterChange = False
  End If
End Sub

Private Sub Form_Load()
On Error GoTo ErrHandler
  Caption = Caption & " for unit " & CStr(UnitMods.Unit)
  ID = UnitMods.ID
  CHANGE_FLAG = 0
  If UnitMods.Model = "KLIC" Then
    lblParameter(0).Visible = False
    Parameter(0).Visible = False
    lblParameter(1).Caption = "Volume of column"
    lblParameter(2).Caption = "Air holdup in the column %"
    lblParameter(4).Caption = "Number of columns in parallel"
  End If
  If UnitMods.Model = "KLIM" Then
    lblParameter(0).Visible = True
    Parameter(0).Visible = True
    lblParameter(1).Caption = "Volume of each cell in this bank"
    lblParameter(2).Caption = "Air holdup in the cells %"
    lblParameter(4).Caption = "Number of banks in parallel"
  End If
' Find the current data for this model if any
  If CURRMODELDATA(ID).Model <> UnitMods.Model Then
    OptCurrent.Enabled = 0
    LoadDefault
    Call MakeNew(NEWDATA)
  Else
    Call LoadNew(CURRMODELDATA(ID))
    Call MakeNew(NEWDATA)
  End If
  Exit Sub

ErrHandler:
  MsgBox "Error loading model parameter data", 16, "ERROR"
  Exit Sub
End Sub

Private Sub LoadDefault()
'************************
    Dim J2 As Integer, I As Integer
    If UnitMods.Model = "KLIM" Then
       J2 = Match(UnitMods.Unit, 6)
       If J2 > 20 Then
         MsgBox "The number of cells in the bank could not be determined from the flowsheet." & Chr(13) & Chr(13) & "Edit the flowsheet to get this information if necessary.", 64, "INFORMATION"
         Parameter(0).text = CStr(1)
       Else
         Parameter(0).text = CStr(NOCELL(J2))
       End If
    End If
    If UnitMods.Model = "KLIC" Then
        Parameter(0).text = CStr(1)
    End If
    Parameter(1).text = CStr(10)
    Parameter(2).text = CStr(15)
    Parameter(3).text = CStr(55)
    Parameter(4).text = CStr(1)
    optVolume(0).Value = -1
    For I = 1 To Val(Sysdata.NGCM.text)
      lblParameter(5 + 2 * (I - 1)).Visible = True
      Parameter(5 + 2 * (I - 1)).Visible = True
      Parameter(6 + 2 * (I - 1)).Visible = True
      Parameter(5 + 2 * (I - 1)).text = Str$(90)
      Parameter(6 + 2 * (I - 1)).text = Str$(1)
    Next I
    For I = Val(Sysdata.NGCM.text) + 1 To 12
      lblParameter(5 + 2 * (I - 1)).Visible = 0
      Parameter(5 + 2 * (I - 1)).Visible = 0
      Parameter(6 + 2 * (I - 1)).Visible = 0
    Next I
End Sub

Private Sub LoadNew(NDATA As ModelData)
'**************************************
  Dim I As Integer
    For I = 1 To 5
      Parameter(I - 1).text = Str$(NDATA.PARAM(I))
    Next I
    For I = 6 To NDATA.NOPAR
      lblParameter(I - 1).Visible = True
      Parameter(I - 1).Visible = True
      Parameter(I - 1).text = Str$(NDATA.PARAM(I))
    Next I
    For I = NDATA.NOPAR + 1 To 28
      Parameter(I - 1).Visible = False
    Next I
    optVolume(0).Value = -1
End Sub

Private Sub MakeNew(NDATA As ModelData)
  Dim I As Single
  CHANGE_FLAG = 0
  If UnitMods.Model = "KLIM" Then NDATA.Model = "KLIM"
  If UnitMods.Model = "KLIC" Then NDATA.Model = "KLIC"
  NDATA.NOPAR = 5 + 2 * Val(Sysdata.NGCM.text)
  For I = 1 To NDATA.NOPAR
    NDATA.PARAM(I) = Val(Parameter(I - 1).text)
  Next I
  'Convert the size to meters
  If optVolume(1).Value Then NDATA.PARAM(3) = NDATA.PARAM(3) * 0.028317
End Sub

