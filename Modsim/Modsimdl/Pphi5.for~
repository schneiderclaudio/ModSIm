          CALL RWICY(T,T1,T2,T3,F,O1,O2,O3,D1,D2,D3,ND,NG,NS,
     *    W,W1,W2,W3,SZ,P,PP,IPP,FL,NPP,GM,GV,NM,NGM)
        CASE ('CSCN')
          CALL RCSCN(T,T1,T2,T3,F,O1,O2,O3,D1,D2,D3,ND,NG,NS,
     *    W,W1,W2,W3,SZ,P,PP,IPP,FL,NPP,GM,GV,NM,NGM)
        CASE ('KLIC')
          CALL RKLIC(T,T1,T2,T3,F,O1,O2,O3,D1,D2,D3,ND,NG,NS,
     *    W,W1,W2,W3,SZ,P,PP,IPP,FL,NPP,GM,GV,NM,NGM)
        CASE ('JNES')
          CALL RJNES(T,T1,T2,T3,F,O1,O2,O3,D1,D2,D3,ND,NG,NS,
     *    W,W1,W2,W3,SZ,P,PP,IPP,FL,NPP,GM,GV,NM,NGM)
        CASE DEFAULT
          NumSizeClasses = ND
          NumGClasses = NG
          NumSClasses = NS
          NumberOfMinerals = NM
          TotalSolidsF = T
          CALL WaterFlow(FeedWater,W,T)
          CALL PackIn(F_,F,ND,NG,NS)
          CALL EQUATE(Parameters,P,1,NP)
          CALL EQUATE(RepSize,SZ,1,ND)
          Do I = 1,NGM
            Do J = 1,NM
              GradeM(I,J) = GM(I,J)
              GradeV(I,J) = GV(I,J)
            End Do
          End Do
          CALL EQUATE(SolidSpGr,PP,IPP(  1,1),IPP(  1,2))
          CALL EQUATE(Texture,PP,IPP(  2,1),IPP(  2,2))
          CALL EQUATE(MagnSusceptG,PP,IPP(  3,1),IPP(  3,2))
          CALL EQUATE(OtherPropG,PP,IPP(  4,1),IPP(  4,2))
          CALL EQUATE(FlotnRateConst,PP,IPP(  5,1),IPP(  5,2))
          CALL EQUATE(MagnSusceptS,PP,IPP(  6,1),IPP(  6,2))
          CALL EQUATE(OtherPropS,PP,IPP(  7,1),IPP(  7,2))
          CALL EQUATE(CalValue,PP,IPP(  8,1),IPP(  8,2))
          CALL EQUATE(TotalSulfur,PP,IPP(  9,1),IPP(  9,2))
          CALL EQUATE(PyriticSulf,PP,IPP( 10,1),IPP( 10,2))
          NumberOfMessages = 0
          Reporting =  .TRUE.
          UnitNumber = NUNIT
          UnitType = II
          JobName = JobN
          CALL MODELSEQUENCE(ModelCode)

          T1 = TotalSolidsT; T2 = TotalSolidsC; T3 = TotalSolidsM
          W2 = ConcentrateWater ; W1 = TailingsWater
          W3 = MiddlingsWater
          CALL EQUATE(O1,T_,1,ND*NG*NS)
          CALL EQUATE(O2,C_,1,ND*NG*NS)
          CALL EQUATE(O3,M_,1,ND*NG*NS)

          IF(NumberOfMessages .GT. 0 ) Then
            LENG = LEN_TRIM(UnitJobPath)
            OPEN(14,FILE=UnitJobPath(1:LENG)//'UserDiagFile.txt')
            Do I = 1,NumberOfMessages
              READ(14,'(A80)') Message
              LENG = LEN_TRIM(Message)
              Write(UnitDiagFile,'(80A1)') (Message(J:J),J = 1,LENG)
            End Do
            Close(14)
          End If
      END SELECT
      RETURN
      END
 
      SUBROUTINE EQUATE(ARRAY1,ARRAY2,ISTART,N)
      !****************************************
      REAL ARRAY1(*),ARRAY2(*)
      INTEGER N, I
      DO I = 1,N
        ARRAY1(I) = ARRAY2(I+ISTART-1)
      END DO

      RETURN
      END
 
      SUBROUTINE WaterFlow(Water,W,Solids)
      !***********************************
       LOGICAL UNITWFEED
       REAL WATERADD, SOLIDCONT
       COMMON /WATERFEED/ UNITWFEED, WATERADD, SOLIDCONT
       IF(UNITWFEED) THEN
         IF(SOLIDCONT .LE. 0.0) THEN
           Water = W + WATERADD
         ELSE
           WTR1 = Solids*(100.0-SOLIDCONT)/SOLIDCONT
           WATERADD = WTR1 - W
           Water = WTR1
         END IF
       ELSE
         Water = W
       END IF
       END
