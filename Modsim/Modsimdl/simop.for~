C*******************   PROGRAM SIMOP1    *********************C
C                                                             C
C                                                             C
C  THIS IS THE OUTPUT MODULE FOR MODSIM.                      C
C                                                             C
C  (C) COPYRIGHT RP KING  JOHANNESBURG 1985                   C
C*************************************************************C
C
C  This Program copies the output from the simulation to the output file.
C
      FUNCTION SIMOP(JobPath,CumOut)
C     ******************************
C     Sets up the output file using the data from the simulation and the
C     format information from file FORMAT.DAT which is created by VB form
C     Outform.frm
C     CumOut defines cumulative output requirements. 0 = None, 1 = write into
C       cumulative output file with column headings, 2 = write into cumulative
C       output file without column headings(not implemented).
C

      USE PORTLIB
      USE MSFLIB
	USE SIMOPMODULE
c This function must be exported from the DLL
      !MS$ATTRIBUTES STDCALL, DLLEXPORT :: SIMOP
      !MS$ATTRIBUTES ALIAS :'SIMOP' :: SIMOP
      INTEGER*2 SIMOP
	  INTEGER*4 CumOut
      CHARACTER*255 JobPath
      !MS$ATTRIBUTES REFERENCE :: JobPath
      !MS$ATTRIBUTES REFERENCE :: CumOut
      REAL WSI(2),MFS(100),WTR(100)
      REAL FDMIN(7),MFMIN2(7,100)
      REAL StreamSV(100),StreamSG(100)
      REAL GMEMIN(7,7),FDMET(7)
	INTEGER IND(2)
      INTEGER,ALLOCATABLE :: PLINP(:),PLOUT(:)
      INTEGER ISTRM(100),STREAM,UNIT
      INTEGER NAccStreams,IAccStreamList(100)
      INTEGER STMIN,STMET
      INTEGER DIMPP
      LOGICAL INPFL(100),MFFLG(100)
      LOGICAL WATERF,TMSFL,MINSFL,SIZEFL,CUMFL
      LOGICAL PERSFL,METALF,METALFL,COALFL,PROXFL,CVFLAG,SULPFL,PYRFL
      LOGICAL GOLDFL
      LOGICAL FormatFileFound
      CHARACTER*4 NAME(7)
      CHARACTER*8 METAL(7)
      CHARACTER*1 OP(10,156)
      CHARACTER*80 IDEN
      CHARACTER*11 SUNITS(6)
      CHARACTER*7 WUNITS(5)
      CHARACTER*7 CVUNITS(3)
	CHARACTER*3 MetalUnits(2)
      CHARACTER*5 FlagCode
	CHARACTER*80 FMT
      INTEGER RepUnitNumber(5)
	REAL MUnitsFactor
      CHARACTER*80 ParameterName(5)
      CHARACTER*80 HoldParameters
      LOGICAL LevelFlag(5)
      REAL CVCONVER(3)
      INTEGER FORMFILE
      INTEGER*4 NLAB
      INTEGER FLYFILE
      INTEGER CumFile
      INTEGER DiagFile

      DATA SUNITS/'   kg/s    ',' tonne/hr  ','  kt/mnth  ',
     *' Mtonne/yr ',' s ton/hr  ',' s ton/day '/
      DATA WUNITS/' kg/s  ','tonne/h','m^3/hr ',' L/min ',
     *'gal/min'/
	DATA MetalUnits/' % ','g/t'/
      DATA CVUNITS/' MJ/kg ','Btu/lb ',' cal/g '/
      DATA CVCONVER/1.0, 2.3260E-3, 4.1868E-3/

      LENG = LEN_TRIM(JobPath)
C Open a diagnostic file for error ouput
      DiagFile = 13
      OPEN(DiagFile, FILE = JobPath(1:LENG)//'DiagSIMOP.txt')
      write(DiagFile,*)' The data output routine has started'

      CALL SETUP
      IIN=11
      IFILE=12
      FORMFILE = 31
      OPEN(IIN, FILE = JobPath(1:LENG)//'OPDISP.DAT',ERR = 9001)
      GO TO 9000
 9001   WRITE(DiagFile,*)' Error opening file OPDISP.DAT'
        SIMOP = 1
        CLOSE (DiagFile)
        RETURN
 9000 CONTINUE
C
C
C  INITIALISE FLAGS
      TMSFL=.FALSE.
      LSTMET=0
      LSTMIN=0
C
C  READ DATA FROM FILE OPDISP.
C  ***************************
      GO TO 30
 9006   WRITE(DiagFile,*)' Error reading file OPDISP.DAT'
        SIMOP = 2
        CLOSE(IIN)
        CLOSE (DiagFile)
        RETURN
 9007   WRITE(DiagFile,*)' End of file OPDISP.DAT reached'
        SIMOP = 3
        CLOSE(IIN)
        CLOSE (DiagFile)
        RETURN
   30 CONTINUE
      READ(IIN,'(A80)',ERR = 9006, END = 9007)IDEN
      NLAB = LEN_TRIM(IDEN)
      READ(IIN,1001,ERR = 9006, END = 9007) NPLANT,NOMIN,NDCM,NGCM
 1001 FORMAT(19I4)
      DO I=1,NOMIN
        READ(IIN,'(A4)',ERR = 9006, END = 9007) NAME(I)
      END DO
      DO I=1,NGCM
        READ(IIN,1003,ERR = 9006, END = 9007)(GRDM(I,J),J=1,NOMIN)
      END DO
      READ(IIN,'(I5)') DIMPP
      READ(IIN,'(8G10.4)')(PPROP(I),I = 1,DIMPP)
 1003 FORMAT(7G10.4)
      READ(IIN,1001,ERR=9006,END=9007)NPLT,NNODE,NTEAR,NUNIT,NSTRE,
     *NPINP,NPOUT

	IF( .NOT. ALLOCATED(PLINP)) ALLOCATE(PLINP(NPINP))
	IF( .NOT. ALLOCATED(PLOUT)) ALLOCATE(PLOUT(NPOUT))

      READ(IIN,1001,ERR = 9006, END = 9007) (PLINP(I),I=1,NPINP)
      DO STREAM = 1,NSTRE
        INPFL(STREAM)=.FALSE.
        MFFLG(STREAM)=.FALSE.
      END DO
      READ(IIN,1001,ERR = 9006, END = 9007) (PLOUT(I),I=1,NPOUT)
      READ(IIN,1001,ERR = 9006, END = 9007) NDC,NGC,NSC
      READ(IIN,1018,ERR = 9006, END = 9007) (SIZE(I),I=1,NDC)
 1018 FORMAT(6G12.4)

C
C  START READING STREAM DATA.
      DO MIN=1,NOMIN
        FDMIN(MIN)=0.0
        DO STREAM = 1,NSTRE
          DO I = 1,NDC
            MFMIN(MIN,STREAM,I)=0.0
          END DO
          MFMIN2(MIN,STREAM)=0.0
        END DO
      END DO
      DO STREAM = 1,NSTRE
        DO J=1,NGC
          MFSGC(J,STREAM)=0.0
        END DO
      END DO
   40 READ(IIN,1007,END=9002,ERR = 9006) I1,I2,(IND(I),I=1,I1)
 1007 FORMAT(2I2,18I4)
      IF(I2.EQ.99) GOTO  100
      READ(IIN,1003,ERR = 9006, END = 9007)(WSI(I),I=1,I2)
      STREAM=IND(1)
      IF(STREAM.GT.NSTRE) NSTRE=STREAM
      IF(I1.EQ.2) UNIT=IND(2)
      MFS(STREAM)=WSI(1)
	write(Diagfile,*)'STREAM,MFS(STREAM)',STREAM,MFS(STREAM)
      INPFL(STREAM)=.TRUE.
      WTR(STREAM)=WSI(I2)
      IF(I2.NE.1) GOTO 50
      MFS(STREAM)=0.0
      MFFLG(STREAM)=.FALSE.
      GOTO 40
 9002 CONTINUE
C  WRITE A MESSAGE TO INDICATE THAT THERE IS NOT SUFFICIENT INPUT DATA.
      WRITE(Diagfile,*)' The calculation phase has not produced sufficie
     *nt output data'
        SIMOP = 3
        CLOSE(IIN)
        CLOSE (DiagFile)
      RETURN
   50 CONTINUE
      DO KK = 1,NSC
        DO JJ = 1,NGC
          IPOS=(JJ-1)*NDC+(KK-1)*NDC*NGC
          READ(IIN,1004,ERR=9006,END=9007)K,J,II,(VALS(I+IPOS),I=1,II)
 1004     FORMAT(3I4/(6G13.5))
          IF(K.NE.KK.OR.J.NE.JJ.OR.II.NE.NDC) THEN
            WRITE(DiagFile,1006) STREAM,K,J,II
 1006       FORMAT(' ERROR STREAM',I4,' S CLASS',I3,' G CLASS',I3,
     *      ' D CLASS',I3)
            SIMOP = 1
            RETURN
          END IF
          DO I = 1,NDC
            IF(.NOT. MFFLG(STREAM)) THEN
              MFSGC(J,STREAM) = MFSGC(J,STREAM) + VALS(I+IPOS)
              IPOS = (J-1)*NDC + (K-1)*NDC*NGC
              DO MIN = 1,NOMIN
                MFMIN(MIN,STREAM,I)=MFMIN(MIN,STREAM,I)+
     *          VALS(I+IPOS)*GRDM(J,MIN)
              END DO
            END IF
          END DO
        END DO
      END DO

      CALL LIBDISPM(VALS,NDC,NGC,NSC,STREAM,JobPath,LENG)
      IF(MFS(STREAM) .LE. 0.0 .OR. MFFLG(STREAM)) GO TO 40

      CALL SGM(VALS,NDC,NGC,NSC,PPROP,SVM,SGA)
      StreamSV(STREAM) = SVM
      StreamSG(STREAM) = SGA
      CALL PARTSZ(SIZE,VALS,NDC,NGC,NSC,CUMSIZ,CUM,DENS)
      DO I = 1,NDC
        MEMCUM(STREAM,I)=CUM(I)
      END DO
      MFFLG(STREAM)=.TRUE.

      GO TO  40

  100 CONTINUE
      CLOSE(IIN)
C
C  CALCULATE FEEDRATE OF EACH MINERAL.
C  ***********************************
      DO MIN = 1,NOMIN
        DO STREAM = 1,NSTRE
          DO I = 1,NDC
            IF(MFMIN(MIN,STREAM,I) .GE. 1.0E-8) THEN
              IF(INPFL(STREAM))
     *        MFMIN2(MIN,STREAM)=MFMIN2(MIN,STREAM)+MFMIN(MIN,STREAM,I)
            END IF
          END DO
        END DO
      END DO
      TOTALM=0.0
      DO I = 1,NPINP
        ISTR = PLINP(I)
        TOTALM = TOTALM + MFS(ISTR)
        DO MIN = 1,NOMIN
          FDMIN(MIN) = FDMIN(MIN) + MFMIN2(MIN,ISTR)
        END DO
      END DO
	IF( ALLOCATED(PLINP)) DEALLOCATE(PLINP)
	IF( ALLOCATED(PLOUT)) DEALLOCATE(PLOUT)
C
C  READ SIMOP DATA FILE
C  ********************
C  READ INDICATOR FLAGS IN SIMOP DATA FILE
C  ***************************************
      METFIL=14
      OPEN(METFIL,FILE = JobPath(1:LENG)//'SIMOP.DAT',ERR = 9004)
      READ(METFIL,4010, END = 4020, ERR = 9008)COALFL,
     *PROXFL,CVFLAG,SULPFL,PYRFL,GOLDFL
 4010 FORMAT(6L1)
      GO TO 4030
 9004   WRITE(DiagFile,*)' Error opening file SIMOP.DAT'
        SIMOP = 4
        CLOSE(IIN)
        CLOSE (DiagFile)
        RETURN
 4020   MINSFL = .FALSE.
        METALF = .FALSE.
        COALFL = .FALSE.
        PROXFL = .FALSE.
        CVFLAG = .FALSE.
        SULPFL = .FALSE.
        PYRFL = .FALSE.
        GOLDFL = .FALSE.
 4030 IF(CVFLAG) THEN
        READ(METFIL,*,ERR = 9008, END = 9009) INDEXCV
        READ(METFIL,3030,ERR = 9008, END = 9009)(CALVAL(I),I=1,NGC)
      END IF
      IF(SULPFL) READ(METFIL,3030,ERR=9008,END=9009)(TOTSUL(I),I=1,NGC)
      IF(PYRFL)  READ(METFIL,3030,ERR=9008,END=9009)(PYRSUL(I),I=1,NGC)
 3030 FORMAT(8G10.4)
      CLOSE (METFIL)
C
      GO TO 60
c Error handlers for reading file simop.dat
 9008   WRITE(DiagFile,*)' Error reading file SIMOP.DAT'
        SIMOP = 5
        CLOSE(METFIL)
        CLOSE(DiagFile)
        RETURN
 9009   WRITE(DiagFile,*)' End of file SIMOP.DAT reached'
        SIMOP = 6
        CLOSE(METFIL)
        CLOSE(DiagFile)
        RETURN

   60 CONTINUE
C
C  Read the file containing output formats
c  ***************************************
      FORMFILE = 45
      OPEN(FORMFILE, FILE = JobPath(1:LENG)//'FORMAT.OUT',ERR = 9010)
      WRITE(DiagFile,*)' Opened file FORMAT.OUT'
      GO TO 70
 9010   WRITE(DiagFile,*)' Error opening file FORMAT.OUT'
        SIMOP = 7
        CLOSE (DiagFile)
        RETURN
 9011   WRITE(DiagFile,*)' Error reading file FORMAT.OUT'
        SIMOP = 8
        CLOSE(FORMFILE)
        CLOSE (DiagFile)
        RETURN
 9012   WRITE(DiagFile,*)' End of file FORMAT.OUT reached'
        CLOSE (FORMFILE)
        FormatFileFound = .FALSE.
        IPF = 1
        WATERF = .FALSE.
        IWF = 1
        PERSFL = .FALSE.
        TMSL = .FALSE.
        MINSFL = .FALSE.
        METALFL = .FALSE.
        NOMET = 0
        NOMIN = 1
        GO TO 200
   70 CONTINUE
      READ(FORMFILE,3001,ERR = 9011,END = 9012) IPF, WATERF, IWF,
     * PERSFL, TMSFL, MINSFL,METALFL,IMU
 3001 FORMAT(I1, L1, I1, 4L1,I1)
      FormatFileFound = .TRUE.
      READ(FORMFILE,*,ERR = 9011,END = 9012)NOMET
      IF(NOMET .GT. 0 ) THEN
        READ(FORMFILE,3023,ERR = 9011,END=9012)(METAL(MET),MET=1,NOMET)
 3023   FORMAT(7A8)
        READ(FORMFILE,*,ERR = 9011,END = 9012) NOMIN
        DO MIN = 1,NOMIN
          READ(FORMFILE,*,ERR=9011,END=9012)
     *        (GMEMIN(MET,MIN),MET=1,NOMET)
        END DO
      END IF
      IF(COALFL) MINSFL=.TRUE.
      IF(PROXFL) COALFL=.TRUE.
C
C  ARE SIZE DISTRIBUTIONS REQUIRED?
C  ********************************
C Get the details of the size distribution display from file FORMAT.DAT
      IF(FormatFileFound) THEN
        READ(FORMFILE,'(L1)',ERR = 9011,END = 9012 )SIZEFL
        NSTRM = 0
        IF(SIZEFL) THEN
          READ(FORMFILE,'(I4)',ERR = 9011,END = 9012)NSTRM
          IF(NSTRM .GT. 0) THEN
            READ(FORMFILE,'(20I4)',ERR = 9011,END = 9012)
     *       (ISTRM(IWAS),IWAS=1,NSTRM)
            READ(FORMFILE,'(I4)',ERR = 9011,END = 9012)ICODE
          END IF
        END IF

C       Accumulating stream data?
        WRITE(DiagFile,'('' Simulation number '',I4)')CumOut
        READ(FORMFILE,'(L1)',ERR = 9011,END = 9020 )CUMFL
        WRITE(Diagfile,'(A7,L1)')' CUMFL ',CUMFL
        IF(CUMFL) THEN
          READ(FORMFILE,'(I4)',ERR = 9011,END = 9020)NAccStreams
          Write(DiagFile,'(I4,'' streams selected for output'')')
     *    NAccStreams
          IF(NAccStreams .GT. 0) THEN
            READ(FORMFILE,'(20I4)',ERR = 9011,END = 9020)
     *       (IAccStreamList(IWAS),IWAS=1,NAccStreams)
          END IF
        END IF
      END IF
 9020 CONTINUE
      CLOSE(FORMFILE)
      FormatFileFound = .FALSE.

C Read data about repetitive simulations if any
      IF(CUMFL .and. CUMOUT .GT. 0) THEN
        OPEN(37,FILE = JobPath(1:LENG)//'Repeat.out')
        IF(CumOut .eq. 1) THEN
          Read(37,'(A5)',END = 9996) FlagCode
          WRITE(DIAGFILE,'(A5)')Flagcode
          DO I = 1,5
            IF(FlagCode(I:I) .eq. 'T') THEN
              LevelFlag(I) = .TRUE.
              READ(37,*)Level,RepUnitNumber(I)
              READ(37,'(A80)')ParameterName(I)
              WRITE(Diagfile,*)Level,RepUnitNumber(I),ParameterName(I)
            ELSE
              LevelFlag(I) = .False.
            END IF
          END DO
        END IF
        READ(37,'(A80)',END = 9996)HoldParameters
        LENG1 = LEN_TRIM(HoldParameters)
        WRITE(Diagfile,*)HoldParameters(1:LENG1)
        CALL FLUSH(DiagFile)
        Close (37)
      END IF

      GO TO 8996
 9996 WRITE(Diagfile,*)'End of file Repeat.out'
      SIMOP = 10
      CLOSE (37)
      CLOSE (Formfile)
      RETURN
 8996 CONTINUE

C
C  SELECT OUTPUTS.
C  ***************
  200 CONTINUE
      If (CUMFL .AND. Cumout .GT. 1) Then
        OPEN(IFILE, FILE = JobPath(1:LENG)//'SIM.OUT',ERR = 9003,
     *  ACCESS = 'APPEND')
	Else
        OPEN(IFILE, FILE = JobPath(1:LENG)//'SIM.OUT',ERR = 9003)
      End if
	If (CUMFL) Then
	  WRITE(IFILE,'(//'' Simulation number '',I4)')Cumout
      End if
      WRITE(IFILE,*) IDEN(1:NLAB)
      GO TO 201
 9003   WRITE(DiagFile,*)' Error opening file SIM.OUT'
        SIMOP = 9
        CLOSE(FORMFILE)
        CLOSE (DiagFile)
        RETURN
  201 STMIN=LSTMIN+1
      STMET=LSTMET+1
      IF(IPF.EQ.1) FACTOR=1.0
      IF(IPF.EQ.2) FACTOR=3600.0/1000.0
      IF(IPF.EQ.3) FACTOR=30.0*24.0*3600.0*1.0E-6
      IF(IPF.EQ.4) FACTOR=365.0*24.0*3600.0*1.0E-9
      IF(IPF.EQ.5) FACTOR=3600.0/(2000.0*0.4536)
      IF(IPF.EQ.6) FACTOR=3600.0*24/(2000.0*0.4536)
C
      IF(IWF.EQ.1) WFACTR=1.0
      IF(IWF.EQ.2) WFACTR=3600.0/1000.0
      IF(IWF.EQ.3) WFACTR=3600.0/1000.0
      IF(IWF.EQ.4) WFACTR=60.0
      IF(IWF.EQ.5) WFACTR=60.0/3.785

	IF(IMU .EQ. 1) MUnitsFactor = 100.0
	IF(IMU .EQ. 2) MUnitsFactor = 1e6
C
C Open a file to accept the data for the flyouts
      FLYFILE = 35
      OPEN(FLYFILE,FILE = JobPath(1:LENG)//'Flydata.out')

C Open a file to receive accumulating data from multiple simulations
C if necessary.
      CumFile = 36
      IF(CUMFL .AND. CumOut .EQ. 1) THEN
        OPEN(CumFILE, FILE = JobPath(1:LENG)//'CumData.out')
        WRITE(CumFile,*)'Level Unit  Parameter'
        DO I = 1,5
          IF(FlagCode(I:I) .eq. 'T') THEN
            LevelFlag(I) = .TRUE.
            WRITE(CumFile,'(1X,2I5,2X,A80)')I,RepUnitNumber(I),
     *      ParameterName(I)
          ELSE
            LevelFlag(I) = .False.
          END IF
        END DO
      ELSE IF(CumOut .GE. 2) THEN
      END IF

C
C  PRINT THE TABLE HEADINGS
C  ************************
      CALL MCLEAR(OP,10)
      ICOL=7
      IROW=1
      CALL INSRTC(OP,10,'Stream ',7,1,ICOL)
      CALL INSRTC(OP,10,'number ',7,2,ICOL)
      ICOL=ICOL+14
      CALL INSRTC(OP,10,' Solid     ',11,1,ICOL)
      CALL INSRTC(OP,10,' flow      ',11,2,ICOL)
      CALL INSRTC(OP,10,SUNITS(IPF),  11,3,ICOL)
      WRITE(FLYFILE,'(A11\)')SUNITS(IPF)
      IF(WATERF) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,'Water  ',7,1,ICOL)
        CALL INSRTC(OP,10,'flow   ',7,2,ICOL)
        CALL INSRTC(OP,10,WUNITS(IWF),7,3,ICOL)
      END IF
      WRITE(FLYFILE,'(A9\)')WUNITS(IWF)
      IF(PERSFL) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,'   %   ',7,1,ICOL)
        CALL INSRTC(OP,10,'solids ',7,2,ICOL)
      END IF
      WRITE(FLYFILE,'(A5\)')'% Sol'
      IF(TMSFL .AND. .NOT. COALFL) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,' Yield ',7,1,ICOL)
        CALL INSRTC(OP,10,'   of  ',7,2,ICOL)
        CALL INSRTC(OP,10,' Solids',7,3,ICOL)
      END IF
      IF(COALFL) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,' Solids',7,1,ICOL)
        CALL INSRTC(OP,10,' yield ',7,2,ICOL)
        CALL INSRTC(OP,10,'   %   ',7,3,ICOL)
      END IF
      IF(MINSFL.AND..NOT.PROXFL) THEN
        DO 3010 I=STMIN,NOMIN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,' Rec.  ',7,1,ICOL)
        CALL INSRTC(OP,10,'  of   ',7,2,ICOL)
        CALL INSRTC(OP,10,NAME(I),4,3,ICOL-2)
        ICOL=ICOL+7
        CALL INSRTC(OP,10,' Grade ',7,1,ICOL)
        CALL INSRTC(OP,10,'   of  ',7,2,ICOL)
        CALL INSRTC(OP,10,NAME(I),4,3,ICOL-1)
3010    CONTINUE
      END IF
      IF(PROXFL) THEN
        CALL INSRTC(OP,10,'Proximate analysis',18,1,ICOL+23)
        CALL INSRTC(OP,10,'  Ash    F.C.  Vol.M  Moist ',28,2,ICOL+28)
        CALL INSRTC(OP,10,'   %      %      %      %   ',28,3,ICOL+28)
        ICOL=ICOL+28
        MINSFL=.TRUE.
        WRITE(FLYFILE,'(A6\)')' Ash %'
      END IF
      IF(METALFL) THEN
        DO 3020 I=STMET,NOMET
          ICOL=ICOL+7
          CALL INSRTC(OP,10,' Rec. ',6,1,ICOL)
          CALL INSRTC(OP,10,'  of  ',6,2,ICOL)
          CALL INSRTC(OP,10,METAL(I),4,3,ICOL-1)
          ICOL=ICOL+7
          CALL INSRTC(OP,10,'Grade ',6,1,ICOL)
          CALL INSRTC(OP,10,'  of  ',6,2,ICOL)
          CALL INSRTC(OP,10,METAL(I)//MetalUnits(IMU),4,3,ICOL-1)
          WRITE(FLYFILE,'(A6\)')MetalUnits(IMU)//METAL(I)
3020    CONTINUE
      END IF
      WRITE(FLYFILE,'(A6)')'------'
      IF(CVFLAG) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,'   CV  ',7,2,ICOL)
        CALL INSRTC(OP,10,CVUNITS(INDEXCV),7,3,ICOL)
      END IF
      IF(SULPFL) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,'Sulf ',5,2,ICOL)
        CALL INSRTC(OP,10,' %   ',5,3,ICOL)
      END IF
      IF(PYRFL) THEN
        ICOL=ICOL+7
        CALL INSRTC(OP,10,'Pyr.S',5,2,ICOL)
        CALL INSRTC(OP,10,'  %  ',5,3,ICOL)
      END IF
      DO I = 1,3
        WRITE(IFILE,1041) (OP(I,J),J=1,ICOL)
        IF(CUMFL .AND. CumOut .EQ. 1) THEN
          WRITE(CumFile,1041) (OP(I,J),J=1,ICOL)
        END IF
      END DO
      CLOSE(CumFile)
C
C  ESTABLISH THE FEEDRATE OF INDIVIDUAL METALS.
C  ********************************************
      IF(METALFL) THEN
        DO MET = 1,NOMET
          FDMET(MET) = 0.0
          DO MIN = 1,NOMIN
            FDMET(MET) = FDMET(MET) + GMEMIN(MET,MIN)*FDMIN(MIN)
          END DO
        END DO
  116   CONTINUE
      END IF

      WRITE(FLYFILE,'(I4)')NSTRE
      IF(CUMFL) THEN
        WRITE(DiagFile,*)' Open CumFile to append'
        CALL FLUSH(DiagFile)
        OPEN(CumFILE, FILE = JobPath(1:LENG)//'CumData.out',
     *  ACCESS = 'APPEND')
        Write(CumFILE,'(80A1)')(HoldParameters(I:I), I = 1,LENG1)
      END IF

      !Open the Stream Properties file
      !*******************************
      IPROPS = 51
      OPEN(IPROPS, FILE = JobPath(1:LENG)//'STREAMPROPS.TXT')


C  Print the stream variables
C  **************************
      II=(NSTRE-1)/10+1
      STREAM=0
      STMIN=LSTMIN+1
      STMET=LSTMET+1
      DO 150 IC = 1,II
        IROW=0
        CALL MCLEAR(OP,10)
        DO 120 JC=1,10
          STREAM=STREAM+1
          IF(STREAM.GT.NSTRE) GO TO 121
          IF(.NOT.INPFL(STREAM)) GO TO 120
          WRITE(IPROPS,'(''Stream number:'',T30,I3)')STREAM
          WRITE(IPROPS,*) ' Job name: ',IDEN(1:NLAB)
          WRITE(FLYFILE,'(I3\)')STREAM
          IROW=IROW+1
          CALL INSERT(OP,10,STREAM,IROW,4)
          WS=MFS(STREAM)*FACTOR
          CALL INSRTR(OP,10,WS,8.2,IROW,15)
          WRITE(IPROPS,'(''Solid flowrate:'',T30,F8.2,1X,A11)')WS,
     *    SUNITS(IPF)
          CALL FLYWRITE(FLYFILE,8,WS)

          ICOL=21
          WS=WTR(STREAM)*WFACTR
          IF(WATERF) THEN
            ICOL=ICOL+7
            CALL INSRTR(OP,10,WS,7.2,IROW,ICOL)
          END IF
          WRITE(IPROPS,'(''Water flowrate:'',T30,F8.2,1X,A7)')WS,
     *    WUNITS(IWF)
          CALL FLYWRITE(FLYFILE,8,WS)
          WRITE(IPROPS,'(''Slurry flowrate:'',T30,F8.2,'' kg/s'')')
     *    MFS(STREAM) + WTR(STREAM)
          VolFlowrate = MFS(STREAM)*StreamSV(STREAM) + 0.001*WTR(STREAM)
          WRITE(IPROPS,'(''Slurry volumetric flowrate:'',T30,G10.4,
     *    '' m^3/s'')')VolFlowrate
          IF(MFS(STREAM) + WTR(STREAM) .LE. 0.0) THEN
            PERCS = 0.0
            PERCV = 0.0
          ELSE
            PERCS=100.0*MFS(STREAM)/(MFS(STREAM)+WTR(STREAM))
            PERCV=100.0*StreamSV(STREAM)*MFS(STREAM)/VolFlowrate
          END IF
          WRITE(IPROPS,'(''Percent solids by mass:'',T30,F8.2,'' %'')')
     *    PERCS
          WRITE(IPROPS,'(''Percent solids by volume:'',T30,F8.2,
     *    '' %'')') PERCV
          CALL FLYWRITE(FLYFILE,8,PERCS)
          IF(PERSFL) THEN
            ICOL=ICOL+7
            CALL INSRTR(OP,10,PERCS,6.2,IROW,ICOL)
          END IF
          IF(MFS(STREAM) .EQ. 0.0) GO TO 142
          IF(TMSFL.OR.COALFL) THEN
            ICOL=ICOL+7
            REC=100.0*MFS(STREAM)/TOTALM
            CALL INSRTR(OP,10,REC,6.2,IROW,ICOL)
            WRITE(IPROPS,'(''Yield of solids:'',T30,F8.2,'' %'')')REC
          END IF
          IF(MINSFL.AND..NOT.PROXFL) THEN
            DO 140 MIN=STMIN,NOMIN
              ICOL=ICOL+7
              REC=0.0
              IF(FDMIN(MIN).NE.0.0)
     &          REC=100.0*MFMIN2(MIN,STREAM)/FDMIN(MIN)
              GRADE=100.0*MFMIN2(MIN,STREAM)/MFS(STREAM)
              CALL INSRTR(OP,10,REC,7.2,IROW,ICOL)
              WRITE(IPROPS,'(''Recovery of mineral '',A4,T30,F8.2,
     &        '' %'')')NAME(MIN),REC
              ICOL=ICOL+7
              CALL INSRTR(OP,10,GRADE,7.2,IROW,ICOL)
              IF(GRADE .GT. 1.0) THEN
                WRITE(IPROPS,'(''Grade of mineral '',A4,T30,F8.2,
     &          '' %'')')NAME(MIN),GRADE
              ELSE IF(GRADE .GT. 0.01) THEN
                WS = 10*GRADE
                WRITE(IPROPS,'(''Grade of mineral '',A4,T30,F8.2,
     &          '' kg/t'')')NAME(MIN),WS
              ELSE IF(GRADE .LE. 0.01) THEN
                WS = 10000*GRADE
                WRITE(IPROPS,'(''Grade of mineral '',A4,T30,F8.2,
     &          '' g/t'')')NAME(MIN),WS
              END IF
              LSTMIN=MIN
  140       CONTINUE
  143       CONTINUE
          END IF
          IF(PROXFL) THEN
	      write(diagfile, *) ' PROXFL true'
            DO 144 MIN=1,NOMIN
              ICOL=ICOL+7
	        Write(diagfile,*)' Min, ICOL ',MIN,ICOL
              IF(MFS(STREAM) .GT. 0.0) THEN
                GRADE=100.0*MFMIN2(MIN,STREAM)/MFS(STREAM)
              ELSE
                 GRADE = 0.0
              END IF
              CALL INSRTR(OP,10,GRADE,7.2,IROW,ICOL)
              IF(MIN .EQ. 1) THEN
                WRITE(IPROPS,'(''Ash content '',T30,F8.2,'' %'')')GRADE
              ELSE IF(MIN .EQ. 2) THEN
                WRITE(IPROPS,'(''Fixed carbon '',T30,F8.2,'' %'')')GRADE
              ELSE IF(MIN .EQ. 3) THEN
                WRITE(IPROPS,'(''Volatile matter '',T30,F8.2,'' %'')')
     *          GRADE
              ELSE IF(MIN .EQ. 4) THEN
                WRITE(IPROPS,'(''Moisture '',T30,F8.2,'' %'')')GRADE
              END IF
              IF(MIN .EQ. 1) CALL FLYWRITE(FLYFILE,6,GRADE)
  144       CONTINUE
          END IF
          IF(METALFL) THEN
            DO 147 MET=STMET,NOMET
              ICOL=ICOL+7
              FLOMET=0.0
              DO 146 MIN=1,NOMIN
                FLOMET=FLOMET+GMEMIN(MET,MIN)*MFMIN2(MIN,STREAM)
  146         CONTINUE
              REC=0.0
              IF(FDMET(MET).NE.0.0) REC=100.0*FLOMET/FDMET(MET)
              GRADE=100*FLOMET/MFS(STREAM)
              CALL INSRTR(OP,10,REC,7.2,IROW,ICOL)
              WRITE(IPROPS,'(''Recovery of '',A4,T30,F8.2,'' %'')')
     &        METAL(MET),REC
              ICOL=ICOL+7
              CALL INSRTR(OP,10,0.01*GRADE*MUnitsFactor,7.2,IROW,ICOL)
	        FMT = '(''Grade of '',A4,T30,F8.2,1X,'''//MetalUnits(IMU)
     *         //''')'
              WRITE(IPROPS,FMT)METAL(MET),0.01*GRADE*MUnitsFactor
              CALL FLYWRITE(FLYFILE,8,0.01*GRADE*MUnitsFactor)
              LSTMET=MET
  147       CONTINUE
  148       CONTINUE
          END IF
          IF(CVFLAG) THEN
            ICOL=ICOL+7
	      Write(diagfile,*)' CVFLAG true, ICOL',ICOL
            CV=0.0
            DO 160 I=1,NGC
              CV=CV+CALVAL(I)*MFSGC(I,STREAM)
  160       CONTINUE
            CV=CV/MFS(STREAM)
            CV = CV/CVCONVER(INDEXCV)
            CALL INSRTR(OP,10,CV,7.1,IROW,ICOL)
            WRITE(IPROPS,'(''Calorific value '',T30,F8.2,1X,A7)')CV,
     &      CVUNITS(INDEXCV)
          END IF
          IF(SULPFL) THEN
            ICOL=ICOL+7
	      Write(diagfile,*)' SULPFL true, ICOL',ICOL
            TS=0.0
            DO 170 I=1,NGC
              TS=TS+TOTSUL(I)*MFSGC(I,STREAM)
  170       CONTINUE
            TS=TS/MFS(STREAM)
            CALL INSRTR(OP,10,TS,7.2,IROW,ICOL)
            WRITE(IPROPS,'(''Total sulfur '',T30,F8.2,'' %'')')TS
          END IF
          IF(PYRFL) THEN
           ICOL=ICOL+7
 	     Write(diagfile,*)' PYRFL true, ICOL',ICOL
            PS=0.0
            DO 180 I=1,NGC
              PS=PS+PYRSUL(I)*MFSGC(I,STREAM)
  180       CONTINUE
            PS=PS/MFS(STREAM)
            CALL INSRTR(OP,10,PS,7.2,IROW,ICOL)
            WRITE(IPROPS,'(''Pyritic sulfur '',T30,F8.2,'' %'')')PS
          END IF
  142     CONTINUE
 1041     FORMAT(156A1)
          WRITE(IFILE,1041)(OP(IROW,I),I=1,ICOL)

c         Is this stream to be accumulated
          IF(CUMFL .AND. CumOut .GT. 0 ) THEN
            DO IWAS = 1,NAccStreams
              IF(IAccStreamList(IWAS) .eq. STREAM) THEN
                WRITE(CumFile,1041)(OP(IROW,I),I=1,ICOL)
              END IF
            END DO
          END IF

          !Write the size distribution to the stream properties file
          write(diagfile,*)' Ready to write size distribution'
          CALL FLUSH(DiagFile)
          IF (NDC .GE. 3 .AND. MFFLG(STREAM)) then
            WRITE(IPROPS,'(/''Simulated size distribution'')')
            WRITE(IPROPS,'(''Number of size classes:'',T30,I3)')NDC
            DO I=1,NDC
              CUM(I)=MEMCUM(STREAM,I)
            END DO
            P = 80.0
            CALL PASSSZ(CUMSIZ,CUM,NDC,P,PSIZ)
            write(IPROPS,'(''80% passing size:'',T30,G10.3,'' m'')')PSIZ
            P = 50.0
            CALL PASSSZ(CUMSIZ,CUM,NDC,P,PSIZ)
            write(IPROPS,'(''50% passing size:'',T30,G10.3,'' m'')')PSIZ
            P =20.0
            CALL PASSSZ(CUMSIZ,CUM,NDC,P,PSIZ)
            write(IPROPS,'(''20% passing size:'',T30,G10.3,'' m'')')PSIZ
            CALL WRSZDN(CUMSIZ,CUM,NDC,ICODE,IPROPS)
          END IF
          write(IPROPS,'('' '')')   !Puts a blank line into the stream properties file.

          WRITE(FLYFILE,'(A8)')'--------' !Also puts a CR LF at the end of the line
  120   CONTINUE
  121   CONTINUE
  150 CONTINUE
      CLOSE(FLYFILE)
      CLOSE(IPROPS)
      write(DiagFile,*)'Closing CumFile'
      CALL FLUSH(DiagFile)
      CLOSE(CumFile)
C
C     Write data for graphical output.
C     ********************************
      OPEN(33,FILE = JobPath(1:LENG)//'OPGRAPH.DAT')
      WRITE(33,'(80A1)') (IDEN(I:I),I=1,NLAB)
      WRITE(33,'(''Number of classes'',3I5)') NDC,NGC,NSC
      IF(NDC.GT.1) THEN
        WRITE(33,'(''Number of streams '',I5)') NSTRE
        WRITE(33,'(/''Data input flags'')')
        WRITE(33,'(80L1)') (INPFL(I),I=1,NSTRE)
        WRITE(33,'(/''Flags to indicate solids in the streams'')')
        WRITE(33,'(80L1)') (MFFLG(I),I=1,NSTRE)
        WRITE(33,'(/''Representative sizes'')')
        WRITE(33,'(6G13.4)')(SIZE(I),I=1,NDC)
        WRITE(33,'(/''Mesh sizes'')')
        WRITE(33,'(6G13.4)')(CUMSIZ(I),I=1,NDC)
        DO 3040 I=1,NSTRE
          WRITE(33,'(''Stream'',I5)') I
          WRITE(33,'(6G13.4)') (MEMCUM(I,J),J=1,NDC)
 3040   CONTINUE
      END IF
      CLOSE(33)
C     Generate the size distributions
C     *******************************
C
      IF(NDC.EQ.1) GO TO 2024
C
      DO 99 IWAS=1,NSTRM
        NOS=ISTRM(IWAS)
        WRITE(IFILE,2026)NOS
 2026   FORMAT(//' PARTICLE SIZE DISTRIBUTION FOR STREAM ',I2,/)
        DO I=1,NDC
          CUM(I)=MEMCUM(NOS,I)
        END DO
        CALL WRSZDN(CUMSIZ,CUM,NDC,ICODE,IFILE)
   99 CONTINUE
 2024 CONTINUE
C
C If less than 3 G classes dont write any liberation data and
c terminate with an empty LIBDISP.DAT file.
      IF(NGC.LT.3) then
        OPEN(31, FILE = JobPath(1:LENG)//'LIBDISP.DAT')
        ENDFILE 31
        WRITE(DiagFile,*) ' No liberation data.'
        SIMOP = -1
        CLOSE(31)
        CLOSE(IFILE)
        CLOSE (DiagFile)
        RETURN
      END IF
C
C  DISPLAY THE LIBERATION DATA
C  ***************************
      CALL LIBDISP(MFS,NGC,NSTRE,FDMIN,NOMIN,
     *IFILE,JobPath,LENG)
 9999 CONTINUE
      SIMOP = -1
      CLOSE(FORMFILE)
      CLOSE(IFILE)
      CLOSE (DiagFile)
      RETURN
      END
C
      SUBROUTINE FLYWRITE(NFILE,NFIELD,VALUE)
C     ***************************************
C Write a flyout entry with variable format.
C NFIELD is the required field width.
      INTEGER NFIELD,DIGITS,NFILE
      CHARACTER*7 FlyFormat
      IF(ABS(VALUE) .EQ. 0.0) THEN
        DIGITS = 0
      ELSE
        DIGITS = INT(3 - ALOG10(ABS(VALUE)))
        IF(DIGITS .GT. NFIELD - 2) DIGITS = NFIELD - 2
        IF(DIGITS .LT. 1) DIGITS = 1
      END IF
      WRITE(FlyFormat,'(''(F'',I1,''.'',I1,''\)'')')NFIELD,DIGITS
      WRITE(NFILE,FlyFormat)VALUE
      RETURN
      END

C
      SUBROUTINE LIBDISP(MFS,NGC,NSTRE,FDMIN,NOMIN,
     *IFILE,JobPath,LENG)
C     **********************************************************
C  WRITE THE DATA TO DISPLAY THE LIBERATION CHARACTERISTICS
      USE SIMOPMODULE
      REAL MFS(100)
      REAL FDMIN(7),CumRecMin(7)
      REAL CumMassMin(7),CumGradeMin(7)
      CHARACTER*20 FormatText
      CHARACTER(255) JobPath

      OPEN(33, FILE = JobPath(1:LENG)//'LIBDISP.DAT')
      WRITE(33,'(I5)') NGC

C  SELECT THE STREAMS
      WRITE(IFILE,1000)
 1000 FORMAT(//' LIBERATION SPECTRA'/
     *         ' ******************')
      DO 20 NS=1,NSTRE
        IF(MFS(NS).GT.0.0) THEN
C         Initialize the cumulative recovery of each mineral
          DO NMIN = 1,NOMIN
            CumRecMin(NMIN) = 0.0
            CumMassMin(NMIN) = 0.0
          END DO
          WRITE(IFILE,1001)NS
          WRITE(33,2001)NS
 1001     FORMAT(/' Stream number',I4/
     *    'G-class  Fractional  Cumulative  Cumulative  Cumulative',
     *    '  Cumulative'/
     *    '        distribution  recovery      grade     recovery',
     *    '      grade'/
     *    '                         of           of         of',
     *    '           of'/
     *    '                      mineral 1   mineral 1   mineral 2',
     *    '   mineral 2')
 2001     FORMAT('Stream',I5)
          CumMass = 0.0
          DO 10 NG = 1,NGC
            WS = 0.0
            IF(MFS(NS) .GT. 0.0) WS=MFSGC(NG,NS)/MFS(NS)
            CumMass = CumMass + MFSGC(NG,NS)
            DO NMIN = 1,NOMIN
              IF(FDMIN(NMIN) .GT. 0.0) THEN
                CumRecMin(NMIN) = CumRecMin(NMIN) +
     *          100*MFSGC(NG,NS)*GRDM(NG,NMIN)/FDMIN(NMIN)
              END IF
              CumMassMin(NMIN) = CumMassMin(NMIN) +
     *        MFSGC(NG,NS)*GRDM(NG,NMIN)
              IF(CumMass .Gt. 0.0) Then
                CumGradeMin(NMIN) = 100*CumMassMin(NMIN)/CumMass
              ELSE
                CumGradeMin(NMIN) = 0.0
              END IF
            END DO
            WRITE(FormatText,'(''(I4,6X,F7.4,'',I2,''F12.2)'')')
     *      2*NOMIN
            WRITE(IFILE,FormatText) NG,WS,
     *      (CumRecMin(NMIN),CumGradeMin(NMIN),NMIN=1,NOMIN)
            WRITE(33,1002) NG,WS
 1002       FORMAT(2X,I3,12X,G10.4)
   10     CONTINUE
          WRITE(IFILE,*)          !Put the LF CR at the end of the line.
        END IF
   20 CONTINUE
C
C Write the data in matrix form to input conveniently into
C third party graphics packages.
C Write the liberation spectra for composite sizes first
      WRITE(33,'(''Matrix '',2I5)')NSTRE,NGC
      DO 40 NS=1,NSTRE
        IF(MFS(NS).GT.0.0) THEN
          WRITE(33,3001)NS,(MFSGC(NG,NS)/MFS(NS),NG=1,NGC)
        END IF
 3001 FORMAT(I4,(25F5.3))
   40 CONTINUE
      CLOSE(33)
      RETURN
      END
C
C
      SUBROUTINE LIBDISPM(VALS,NDC,NGC,NSC,STREAM,JobPath,LENG)
C     *********************************************************
C  WRITE THE LIBERATION DATA TO DISPLAY THE LIBERATION CHARACTERISTICS
C  USING THIRD PARTY SOFTWARE
      REAL FG(25)
      REAL VALS(*)
      INTEGER STREAM
      CHARACTER(255) JobPath

      OPEN(32, FILE = JobPath(1:LENG)//'LIBDISPM.DAT')
      WRITE(32,'(I5)') NGC
 2001 FORMAT('Unconditional spectrum for stream',I5)

c Write the unconditional spectra
      WRITE(32,2001)STREAM
      WS = 0.0
      DO I = 1,NDC
        DO J = 1,NGC
          DO K = 1,NSC
            IPOS=(J-1)*NDC + (K-1)*NDC*NGC
            WS = WS + VALS(IPOS+I)
          END DO
        END DO
      END DO
      DO I = 1,NDC
        DO J = 1,NGC
          FG(J) = 0.0
          DO K = 1,NSC
            IPOS=(J-1)*NDC + (K-1)*NDC*NGC
            FG(J) =  FG(J) + VALS(IPOS+I)
          END DO
          IF(WS .GT. 0.0) FG(J) = FG(J)/WS
        END DO
        WRITE(32,3002) I,(FG(J),J = 1,NGC)
      END DO

c Write the conditional-on-size spectra
 2002 FORMAT('Conditional-on-size spectra for stream',I5)
      WRITE(32,2002)STREAM
      DO I = 1,NDC
        WS = 0.0
        DO J = 1,NGC
          DO K = 1,NSC
            IPOS=(J-1)*NDC + (K-1)*NDC*NGC
            WS = WS + VALS(IPOS+I)
          END DO
        END DO
        DO J = 1,NGC
          FG(J) = 0.0
          DO K = 1,NSC
            IPOS=(J-1)*NDC + (K-1)*NDC*NGC
            FG(J) =  FG(J) + VALS(IPOS+I)
          END DO
          IF(WS .GT. 0.0) FG(J) = FG(J)/WS
        END DO
        WRITE(32,3002) I,(FG(J),J = 1,NGC)
      END DO
 3002 FORMAT(I4,(25F8.5))
      CLOSE(32)

      RETURN
      END


c      SUBROUTINE EXPER_GRADES(FG,NGC VALS,STREAM)
C     ************************************************
c Calculate the grade distributions in the experimental size distributions
