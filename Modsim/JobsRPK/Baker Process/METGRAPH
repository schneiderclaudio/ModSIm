C
      SUBROUTINE PSCIRC(X,Y,FACT)
C     ***************************
C  DRAWS A SMOOTH CIRCLE OF RADIUS FACT CENTRED AT (X,Y).
C  First stroke the current path and start a new path.
      CALL PSBUFW(' stroke',7)
      CALL PSBUFR(X)
      CALL PSBUFR(Y)
      CALL PSBUFR(FACT)
      CALL PSBUFN(0)
      CALL PSBUFN(360)
      CALL PSBUFW(' arc',4)
      RETURN
      END
C
C
      SUBROUTINE PSWIPE(I1,I2)
C     *************************
C  WIPES OUT THE POSTSCRIPT BUFFER FROM LOCATION I1 TO I2 INCLUSIVE.
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      IDIFF=I2-I1+1
      I=I2+1
      J2=PSPOIN-1
      K=I1-1
      IF(I.GT.J2) GO TO 20
      DO 10 J=I,J2
      K=J-IDIFF
      PSBUFF(K)=PSBUFF(J)
   10 CONTINUE
   20 PSPOIN=K+1
      IF(STPSPN.LE.I1) RETURN
      IF(STPSPN.LE.I2) STPSPN=I1
      IF(STPSPN.GT.I2) STPSPN=STPSPN-IDIFF
      RETURN
      END
C
C
      SUBROUTINE PSOSEG(I)
C     ********************
C
C  OPENS SEGMENT I IN HARD COPY BUFFER.
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      INTEGER ISEGST(500),ISEGEN(500)
      COMMON/PSEGM/ ISEGST,ISEGEN
      ISEGST(I)=PSPOIN
      RETURN
      END
C
C
      SUBROUTINE PSCSEG
C     *****************
C
C  CLOSES THE CURRENT SEGMENT IN THE HARD COPY BUFFER.
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      INTEGER ISEGST(500),ISEGEN(500)
      COMMON/PSEGM/ ISEGST,ISEGEN
      CALL MGQSEG(ICURR)
      IF(ICURR.GT.0) ISEGEN(ICURR)=PSPOIN-1
      RETURN
      END
C
C
      SUBROUTINE PSDSEG(I)
C     ********************
C
C  DELETES SEGMENT I IN THE HARD COPY BUFFER.
      LOGICAL MGQSGX
      INTEGER IDIFF2
      INTEGER ISEGST(500),ISEGEN(500)
      COMMON/PSEGM/ ISEGST,ISEGEN
C  WIPE IT FROM THE POSTSCRIPT BUFFER
      I1 = ISEGST(I)
      I2 = ISEGEN(I)
      CALL PSWIPE(I1,I2)
      IDIFF2=ISEGEN(I)-ISEGST(I)+1
      CALL MGQSGM(MSEG)
      DO 10 J=1,MSEG
      IF(MGQSGX(J)) THEN
        IF(ISEGST(J).GT.ISEGST(I))ISEGST(J)=ISEGST(J)-IDIFF2
        IF(ISEGEN(J).GT.ISEGEN(I))ISEGEN(J)=ISEGEN(J)-IDIFF2
      END IF
   10 CONTINUE
      RETURN
      END
C
      SUBROUTINE BSTEND(I,IST,IE)
C     ***************************
C  FINDS THE START AND END OF THE SEGMENT I IN THE POSTSCRIPT BUFFER
      INTEGER ISEGST(500),ISEGEN(500)
      COMMON/PSEGM/ ISEGST,ISEGEN
      IST=ISEGST(I)
      IE=ISEGEN(I)
      RETURN
      END
C
      SUBROUTINE SCANBF(I1,I2,X,Y,LABEL,NL,PU,SUCC,LAB,ARC,RAD)
C     *********************************************************
C  SCANS THE POSTSCRIPT BUFFER TO LOCATE COMMANDS
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      CHARACTER*80 LABEL
      LOGICAL PU,SUCC,LAB,ARC
      LOGICAL BMATCH
      LAB=.FALSE.
      ARC=.FALSE.
      DO 10 I=I1,I2
        IF(BMATCH(PSBUFF(I),'mt',2)) THEN
          PU=.TRUE.
          GO TO 20
        ELSEIF(BMATCH(PSBUFF(I),'lt',2)) THEN
          PU=.FALSE.
          GO TO 20
        ELSEIF(PSBUFF(I).EQ.'(') THEN
          LAB=.TRUE.
          GO TO 30
        ELSEIF(BMATCH(PSBUFF(I),'arc',3)) THEN
          ARC=.TRUE.
          GO TO 40
        END IF
   10 CONTINUE
      SUCC=.FALSE.
      RETURN
   20 CALL FNDCOO(I,X,Y,SUCC)
      I1=I+2
      RETURN
   30 CALL FNDLAB(I,I2,LABEL,NL,SUCC)
      I1=I+1
      PU=.FALSE.
      RETURN
   40 DO 45 J=1,26
        LABEL(J:J)=PSBUFF(I-34+J)
   45 CONTINUE
      READ(LABEL,'(F8.2,1X,F8.2,1X,F8.2)',ERR=999) X,Y,RAD
      SUCC=.TRUE.
      I1=I+3
      RETURN
  999 SUCC=.FALSE.
      RETURN
      END
C
      FUNCTION BMATCH(STR1,STR2,NC)
C     *****************************
C  CHECKS FOR A MATCH BETWEEN STR1 AND STR2 COMPARING NC CHARACTERS.
      CHARACTER*1 STR1(1)
      CHARACTER*3 STR2
      LOGICAL BMATCH
      BMATCH=.TRUE.
      DO 10 I=1,NC
        BMATCH=BMATCH.AND.(STR1(I).EQ.STR2(I:I))
   10 CONTINUE
      RETURN
      END
C
      SUBROUTINE FNDCOO(I,X,Y,SUCC)
C     *****************************
C  FINDS THE COORDINATE PAIR ASSOCIATED WITH THE POSTSCRIPT COMMAND
      LOGICAL SUCC
      CHARACTER*18 TBUFF
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      DO 10 J=1,18
        TBUFF(J:J)=PSBUFF(I-20+J)
   10 CONTINUE
      READ(TBUFF,'(1X,F8.2,1X,F8.2)',ERR=999) X,Y
      SUCC=.TRUE.
      RETURN
  999 SUCC=.FALSE.
      RETURN
      END
C
      SUBROUTINE FNDLAB(I,I2,LABEL,NL,SUCC)
C     *************************************
C  FINDS THE LABEL
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      CHARACTER*6 TEMP
      CHARACTER*80 LABEL
      LOGICAL SUCC
      DO 20 J=I+1,I2
        DO 10 K=1,6
          TEMP(K:K)=PSBUFF(J+K-1)
   10   CONTINUE
        IF(TEMP.EQ.') show') THEN
          NL=J-I-1
          DO 30 K=1,NL
            LABEL(K:K)=PSBUFF(I+K)
   30     CONTINUE
          SUCC=.TRUE.
          GO TO 40
        END IF
   20 CONTINUE
      SUCC=.FALSE.
      I=I2
      RETURN
   40 CONTINUE
      I=J+5
      RETURN
      END
C
      SUBROUTINE PSPOLY(ITYPE,VERTS,NVERT)
C     ************************************
C Implements the polygon routine.
	STRUCTURE/xyrcoord/
	  REAL xcoord
	  REAL ycoord
	END STRUCTURE
      RECORD/xyrcoord/VERTS(*)
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      CALL PSBUFW(' stroke',7)
      IF(ITYPE .EQ. 4) CALL PSBUFW(' gsave',6)
      CALL PSMOVE(VERTS(1).xcoord, VERTS(1).ycoord)
      DO 10 I = 2,NVERT
        CALL PSPLOT(VERTS(I).xcoord, VERTS(I).ycoord)
   10 CONTINUE
      CALL PSBUFW(' closepath',10)
      IF(ITYPE .EQ. 2) THEN
        CALL PSBUFW(' fill',5)
      END IF
      IF(ITYPE .EQ. 3) THEN
        CALL PSBUFW(' gsave',6)
        CALL PSBUFR(GRAYFILL)
        CALL PSBUFW(' setgray',8)
        CALL PSBUFW(' fill',5)
        CALL PSBUFW(' grestore',9)
      END IF
      IF(ITYPE .EQ. 4) THEN
        CALL PSBUFR(GRAYFILL)
        CALL PSBUFW(' setgray',8)
        CALL PSBUFW(' fill',5)
        CALL PSBUFW(' grestore',9)
      END IF
      RETURN
      END

      SUBROUTINE MGGRAYFILL(F)
C     ************************
C Sets the PostScript gray level
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      GRAYFILL = F
      RETURN
      END
C
      SUBROUTINE MGGRAYLABEL(STRNG,N,F)
C     *********************************
C  Draws a label at the current position and the PostScript image will draw
C  the label using gray value F (0.0 = black, 1.0 = white).
C
      CHARACTER*80 STRNG
      CALL PSBUFW(' gsave',6)
      CALL PSBUFR(F)
      CALL PSBUFW(' setgray',8)
      CALL LABELC(STRNG,N)
      CALL PSBUFW(' grestore',9)

      RETURN
      END
