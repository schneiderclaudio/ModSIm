      SUBROUTINE PCLOSE
C     *****************
C Flushes the postscript buffer, strokes the path, restores, adds the METGRAPH
C logo if necessary, adds the TIFF image to the end of the file if necessary
C then closes the file.
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      COMMON/MGWP51/IBBOX(4),TRANS(2),SCALE(2),ROT
      CALL FLPSBU
      WRITE(LU,1002)
 1002 FORMAT('stroke')
C Close any open gsaves
      DO 10 N = 1,NGSAVE
        WRITE(LU,*)'grestore'
   10 CONTINUE
      NGSAVE = 0

C      WRITE(LU,1000)
 1000 FORMAT('/Helvetica findfont 10 scalefont setfont'/
     *'900 -20 mt ( graphics by METGRAPH) show')

      WRITE(LU,1001)
 1001 FORMAT('restore'/'showpage')
      WRITE(LU,1003)
 1003 FORMAT('%%Trailer')
C
C The following are commented out because MS WORD cannot recognize the
c atend keyword in PostScript
c      WRITE(LU, 1004) (IBBOX(I),I = 1,4)
c 1004 FORMAT('%%BoundingBox: ',4I5)
      WRITE(LU,1005)
 1005 FORMAT('%%EOF')
      CLOSE(LU)
      RETURN
      END
