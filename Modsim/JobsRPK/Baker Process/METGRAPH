C
      SUBROUTINE PSLNWD(W)
C     ********************
C  SETS THE LINE WIDTH
      CALL PSBUFW(' stroke',7)
      CALL PSBUFR(W)
      CALL PSBUFW(' setlinewidth',13)
      RETURN
      END
