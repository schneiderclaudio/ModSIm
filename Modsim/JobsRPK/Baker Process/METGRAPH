C
      SUBROUTINE PSROT(ANGLE)
C     ***********************
C  ROTATES THE COORDINATE SYSTEM ABOUT THE CURRENT POINT.
C
      I=ANGLE
      CALL PSBUFW(' gsave currentpoint translate',29)
      CALL PSBUFN(I)
      CALL PSBUFW(' rotate',7)
      RETURN
      END
