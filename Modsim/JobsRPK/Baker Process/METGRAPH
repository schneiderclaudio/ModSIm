C
      SUBROUTINE PSLAB(LABEL,IC)
C     **************************
C  Sends the string LABEL having IC characters to the PostScript buffer.
C
      INTEGER LABEL(80)
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      IF(ICHARSET .EQ. 3) THEN
        CALL PSOCTLAB(LABEL,IC)
        RETURN
      END IF
      CALL PSBUFW(' (',2)
      DO 10 I=1,IC
        PSBUFF(PSPOIN)=CHAR(LABEL(I))
        PSPOIN=PSPOIN+1
   10 CONTINUE
      CALL PSBUFW(')',1)
      CALL PSBUFW(' show',5)
      RETURN
      END
C
      SUBROUTINE PSOCTLAB(LABEL,IC)
C     *****************************
C Writes a label to the Postscript buffer using octal codes.
C The label is broken into blocks of 10 characters to ensure that the
C PostScript file does not contain labels with a carriage return embedded.
      INTEGER LABEL(80)
      ICC = IC
      ISTART = 1
   10 CONTINUE
      IF(ICC .GT. 10) THEN
        CALL PSHIGHLAB(LABEL(ISTART),10)
        ISTART = ISTART + 10
        ICC = ICC - 10
      ELSE
        CALL PSHIGHLAB(LABEL(ISTART),ICC)
        RETURN
      END IF
      GO TO 10
      END
C
      SUBROUTINE PSHIGHLAB(LABEL,IC)
C     ******************************
C Writes a label to the Postscript buffer using octal codes
      INTEGER LABEL(80)
      CHARACTER*4 CODE
C
      CALL PSBUFW(' (',2)
      DO 10 I=1,IC
        IOCTAL1 = (LABEL(I)+128)/64
        IOCTAL = (LABEL(I)+128) - IOCTAL1*64
        IOCTAL2 = IOCTAL/8
        IOCTAL3 = IOCTAL - IOCTAL2*8
        IOCTAL = 100*IOCTAL1 + 10*IOCTAL2 + IOCTAL3
        WRITE(CODE,'(A1,I3)')'\',IOCTAL
        CALL PSBUFW(CODE,4)
   10 CONTINUE
      CALL PSBUFW(')',1)
      CALL PSBUFW(' show',5)
      RETURN
      END
