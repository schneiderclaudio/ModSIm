      SUBROUTINE PSPLOT(X,Y)
C     **********************
C  The high resolution PLOT primitive for PostScript.
C
      CALL PSBUFR(X)
      CALL PSBUFR(Y)
      CALL PSBUFW(' lt',3)
      RETURN
      END
C
      SUBROUTINE PSMOVE(X,Y)
C     **********************
C  THE MOVE PRIMITIVE FOR POST SCRIPT.
C
      CALL PSBUFR(X)
      CALL PSBUFR(Y)
      CALL PSBUFW(' mt',3)
      RETURN
      END
C
      SUBROUTINE PSRELMOVE(X,Y)
C     *************************
C  THE RELATIVE MOVE PRIMITIVE FOR POST SCRIPT.
C
      CALL PSBUFR(X)
      CALL PSBUFR(Y)
      CALL PSBUFW(' rmt',4)
      RETURN
      END
C
      SUBROUTINE PSCLIP(X1,Y1,X2,Y2)
C     ******************************
C Clips the PostScript image
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      CALL PSBUFW(' stroke gsave',13)
      CALL PSBUFW(' newpath',8)
      NGSAVE = NGSAVE + 1
      CALL PSMOVE(X1,Y1)
      CALL PSPLOT(X2,Y1)
      CALL PSPLOT(X2,Y2)
      CALL PSPLOT(X1,Y2)
      CALL PSBUFW(' closepath',10)
      CALL PSBUFW(' clip',5)
      CALL PSBUFW(' newpath',8)
      RETURN
      END
