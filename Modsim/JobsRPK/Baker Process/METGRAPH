      SUBROUTINE PSINIT(Path)
C     ***********************
C  Opens a buffer for PostScript graphics output.
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath,Path
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET

      JobPath = Path
      LENG = LEN_TRIM(JobPath)
C
C  Set move/draw flag flag to FALSE
C  Calls to PLOT produce a line when GRPFL is true and a move otherwise.
      GRPFL=.FALSE.
C
C  Set the EPSI flag to false. PSCLOSE will produced an encapsulated
C  PostScript file for interchange when EPSI is true. There is a time penalty
C  over the straight PostScript file.
      EPSI = .FALSE.
C
C  Create a new page for the PostScript output.
      CALL PSCRPG(1)
C
      RETURN
      END
C
C
      SUBROUTINE PSCRPG(IP)
C     ********************
C  Creates a new PostScript page.
      CHARACTER*8 FNAME
      INTEGER TAB(128)
      COMMON/TEK/TAB
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      COMMON/MGWP51/IBBOX(4),TRANS(2),SCALE(2),ROT
      CHARACTER*11 FONT
      COMMON /PSFONT/FONT
C
C  Initialise the buffer pointers.
      PSPOIN=1
      STPSPN=1
C
C Set up the default bounding box
        IBBOX(1)=0
        IBBOX(2)=0
        IBBOX(3)=577
        IBBOX(4)=430
      DATA FNAME/'PSFILE00'/
      IF(IP.GT.1) THEN
        CALL PCLOSE
      END IF
      LU=3
C
C  Update the file name.
      J=IP/10
      K=IP-J*10
      FNAME(7:7)=CHAR(TAB(48+J))
      FNAME(8:8)=CHAR(TAB(48+K))
      OPEN(LU,FILE=JobPath(1:LENG)//FNAME)
C
C  Write the program header.
      WRITE(LU,2002) (IBBOX(I),I = 1,4)
 2002 FORMAT('%!PS-Adobe-2.0 EPSF-1.2'/
     *'%This is a PostScript program produced by METGRAPH.'/
     *'%%Creator: METGRAPH'/
     *'%%BoundingBox: ',4I5/
     *'%%Pages: 1')
      WRITE(LU,1003)
 1003 FORMAT('%%EndComments')
      WRITE(LU,1014)
 1014 FORMAT('/mm {2.835 mul} def'/
     *'/lt /lineto load def'/
     *'/mt /moveto load def'/
     *'/rmt /rmoveto load def'/
     *'%%EndProlog')
      WRITE(LU,1004)TRANS(1),TRANS(2),ROT,SCALE(1),SCALE(2)
 1004 FORMAT('save'/
     *F6.1,' mm ',F6.1,' mm translate'/
     *F4.0,' rotate'/
     *2F6.3,' scale'/
     *'1 setlinewidth 2 setlinecap 1 setlinejoin'/
     *' /Helvetica   findfont  27 scalefont setfont')
C Initialise the flags for the new page.
      FONT = 'Helvetica'
      NGSAVE = 0
      GRAYFILL = 1.0
      ICHARSET = 1
      RETURN
      END

C
      SUBROUTINE PSORIE(O)
C     ********************
C  SETS THE ORIENTATION OF THE POSTSCRIPT IMAGE.
C    O='P'.....PORTRAIT
C    O='L'.....LANDSCAPE
      CHARACTER*1 O
      COMMON/MGWP51/IBBOX(4),TRANS(2),SCALE(2),ROT
      IF(O.EQ.'P') THEN
        IBBOX(1)=0
        IBBOX(2)=48
        IBBOX(3)=552
        IBBOX(4)=432
        TRANS(1)=12.5
        TRANS(2)=12.5
        SCALE(1)=0.5
        SCALE(2)=0.5
        ROT=0.0
      ELSE
        IBBOX(1)=90
        IBBOX(2)=120
        IBBOX(3)=570
        IBBOX(4)=730
        TRANS(1)=194
        TRANS(2)=35
        SCALE(1)=0.563
        SCALE(2)=0.563
        ROT=90.0
      END IF
      RETURN
      END
