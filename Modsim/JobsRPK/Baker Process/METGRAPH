      SUBROUTINE PSCONCAT(CMT)
C     ************************
C Concatenates the CMT matrix with matrix CMT
      REAL CMT(6)
      CALL PSBUFW(' [',2)
      DO I = 1,6
        CALL PSBUFR(CMT(I))
      END DO
      CALL PSBUFW('] concat',8)
      RETURN
      END

C
      SUBROUTINE BUFOFW(N)
C     ********************
C  WARNS IF OVERFLOW IS IMMINENT AND FLUSHES THE BUFFER.
      INTEGER PSPOIN,STPSPN
      COMMON/MGPSBU/PSPOIN,STPSPN
      IF(PSPOIN+N .GE. 200000) THEN
        WRITE(1,*)' ***WARNING...PostScript buffer is full and is being
     * flushed'
        CALL FLPSBU
      END IF
      RETURN
      END
C
C
      SUBROUTINE PSBUFN(N)
C     ********************
C  Encodes integer N into the PostScript buffer.
C
      CHARACTER*10 NUMC
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
C
      CALL FORMTC(N,IDIG,NUMC)
      CALL BUFOFW(IDIG+1)
      PSBUFF(PSPOIN)=' '
      PSPOIN=PSPOIN+1
      DO 10 I=1,IDIG
        PSBUFF(PSPOIN)=NUMC(I:I)
        PSPOIN=PSPOIN+1
   10 CONTINUE
      RETURN
      END
C
C
      SUBROUTINE PSBUFR(R)
C     ********************
C  Encodes real number R into the PostScript buffer.
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      CHARACTER*8 TBUFF
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
C
      CALL BUFOFW(9)
      PSBUFF(PSPOIN)=' '
      PSPOIN=PSPOIN+1
      WRITE(TBUFF,'(F8.2)') R
      DO 20 I=1,8
C	IF(TBUFF(I:I) .NE. ' ') THEN
          PSBUFF(PSPOIN)=TBUFF(I:I)
          PSPOIN=PSPOIN+1
C        END IF
   20 CONTINUE
      RETURN
      END
C
C
      SUBROUTINE PSBUFW(WRD,IC)
C     *************************
C  Encodes a word WRD having IC characters into the PostScript buffer.
C
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
C
      CHARACTER*80 WRD
      CALL BUFOFW(IC)
      DO 10 I=1,IC
        PSBUFF(PSPOIN)=WRD(I:I)
        PSPOIN=PSPOIN+1
   10 CONTINUE
      RETURN
      END
C
C
      SUBROUTINE PSPRINT(SF)
C     **********************
C  Flushes anything in the PostScript buffer to the program file
C
      DUMMY = SF
      CALL FLPSBU
      RETURN
      END
C
C
      SUBROUTINE FLPSBU
C     *****************
C  Flushes the PostScript buffer to the print file.
C  The records must end with white space.
      INTEGER PSPOIN,STPSPN
      CHARACTER*1 PSBUFF(200000)
      COMMON/MGPSBC/PSBUFF
      COMMON/MGPSBU/PSPOIN,STPSPN
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
C
      STPSPNM = STPSPN
   10 CONTINUE
      IF(STPSPN.GE.PSPOIN) RETURN
      I2=STPSPN+79
      IF(I2.GE.PSPOIN) I2=PSPOIN-1
      I1=I2-STPSPN-2
      DO 20 I=1,I1
        IN=I2-I+1
        IF(PSBUFF(IN).EQ.' ') GO TO 30
   20 CONTINUE
      IN=I2
   30 WRITE(LU,1001)(PSBUFF(J),J=STPSPN,IN)
 1001 FORMAT(80A1)
      STPSPN=IN+1
      IF(STPSPN.LT.PSPOIN) GO TO 10
      IF(EPSI) THEN
        STPSPN = STPSPNM
      ELSE
        STPSPN=1
        PSPOIN=1
      END IF
      RETURN
      END
