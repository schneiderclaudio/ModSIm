      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      CALL PSBUFW(' stroke grestore',16)
      NGSAVE = NGSAVE - 1
      RETURN
      END
