      SUBROUTINE PSSETFONT(N)
C     ***********************
C Selects a font
      LOGICAL GRPFL, EPSI
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      CHARACTER*11 FONT
      COMMON /PSFONT/FONT
      ICHARSET = 1
      IF (N .EQ. 1) FONT = 'Helvetica'
      IF (N .EQ. 2) FONT = 'Times-Roman'
      IF (N .EQ. 3) FONT = 'Courier'
      IF (N .EQ. 4) THEN
        FONT = 'Symbol'
        ICHARSET = 2
      END IF
      IF (N .EQ. 5) THEN
        FONT = 'Symbol'
        ICHARSET = 3
      END IF
      RETURN
      END
C
      SUBROUTINE PSLBSZ(SIZE)
C     ***********************
C  THIS SUBROUTINE SETS THE LABEL SIZE.
C
      INTEGER FONTSIZE
      CHARACTER*23 WORD
      CHARACTER*11 FONT
      COMMON /PSFONT/FONT

      FONTSIZE = NINT(9*SIZE)
      WRITE(WORD,1001) FONT
 1001 FORMAT(' /',A11,' findfont ')
      CALL PSBUFW(WORD,23)
      CALL PSBUFN(FONTSIZE)
      CALL PSBUFW(' scalefont setfont',18)
      RETURN
      END
