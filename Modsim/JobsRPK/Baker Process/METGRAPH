C
      SUBROUTINE PSPEN(I)
C     *******************
C  THIS SUBROUTINE SELECTS A LINE WIDTH TO REPRESENT THE PEN.
      IP=I-((I-1)/6)*6
      W=0.5+0.5*IP
      CALL PSBUFR(W)
      CALL PSBUFW(' setlinewidth',13)
      RETURN
      END
C
C
      SUBROUTINE PSLNTP(ITP)
C     **********************
C  SETS UP THE LINE TYPE FOR PostScript.
C  Matches the HP7475 line types.
C
C  Stroke the current path before changing to the new line type.
      CALL PSBUFW(' stroke',8)
      IF(ITP.LT.2.OR.ITP.GT.10) CALL PSBUFW(' []',3)
      IF(ITP.EQ.2) CALL PSBUFW(' [1 15]',7)
      IF(ITP.EQ.3) CALL PSBUFW(' [1 8]',7)
      IF(ITP.EQ.4) CALL PSBUFW(' [16 5 3 5]',11)
      IF(ITP.EQ.5) CALL PSBUFW(' [18 7]',7)
      IF(ITP.EQ.6) CALL PSBUFW(' [13 12]',8)
      IF(ITP.EQ.7) CALL PSBUFW(' [1 4]',6)
      IF(ITP.EQ.8) CALL PSBUFW(' [18 5 1 5]',11)
      IF(ITP.EQ.9) CALL PSBUFW(' [11 5 3 3 3 5]',15)
      IF(ITP.EQ.10) CALL PSBUFW(' [6 5 3 3 3 5 3 5]',18)
      CALL PSBUFW(' 0 setdash',10)
      RETURN
      END
