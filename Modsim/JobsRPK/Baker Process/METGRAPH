      SUBROUTINE MAKE_EPSI(FILE_NO)
C     *****************************
C Copies the existing PostScript file, flushes the postscript buffer
c and and closes the epsi file.
      INTEGER FILE_NO
      LOGICAL GRPFL, EPSI
      INTEGER PSPOIN,STPSPN
      COMMON/MGPSBU/PSPOIN,STPSPN
      CHARACTER*256 JobPath
      COMMON/MGPS/JobPath,LENG,GRPFL,EPSI,LU,NGSAVE,GRAYFILL,ICHARSET
      COMMON/MGWP51/IBBOX(4),TRANS(2),SCALE(2),ROT
      CHARACTER*13 FILE_NAME
      CHARACTER*80 LINE
      REAL      LLX, LLY, URX, URY
      INTEGER BND_BOX(4)
      CHARACTER*30 HEADER
      INTEGER*4 IHEAD(8), PS_FILE_LENGTH, TIFF_FILE_SIZE
      EQUIVALENCE (HEADER,IHEAD)
      LOGICAL EREND

      LOGICAL_UNIT = NEXT_LU(10)
      FILE_NAME(1:4) = 'EPSI'
      WRITE(FILE_NAME(5:8),'(I4.4)') FILE_NO
      FILE_NAME(9:9) = CHAR(0)
      LUM = LU
      OPEN(LOGICAL_UNIT, FILE = JobPath(1:LENG)//FILE_NAME)

C Write the index header to the file
      IHEAD(1) = #C6D3D0C5
      IHEAD(2) = #1E
      IHEAD(3) = 0
      IHEAD(4) = 0
      IHEAD(5) = 0
      IHEAD(6) = 0

      CALL GET_BOUND_BOX(LLX, LLY, URX, URY, IMAGE_SIZE)
c     Adjust the bounding box for the scale factor and the translated
C     origin.
      IF(ROT .EQ. 90.0) THEN
        BND_BOX(1) = TRANS(1)*72.0/25.4 - SCALE(2)*URY
        BND_BOX(2) = TRANS(2)*72.0/25.4 + SCALE(1)*LLX
        BND_BOX(3) = TRANS(1)*72.0/25.4 - SCALE(2)*LLY
        BND_BOX(4) = TRANS(2)*72.0/25.4 + SCALE(1)*URX
      ELSE
        BND_BOX(1) = SCALE(1)*LLX + TRANS(1)*72.0/25.4
        BND_BOX(2) = SCALE(2)*LLY + TRANS(2)*72.0/25.4
        BND_BOX(3) = SCALE(1)*URX + TRANS(1)*72.0/25.4
        BND_BOX(4) = SCALE(2)*URY + TRANS(2)*72.0/25.4
      END IF
c

C     This is replaced lower down
      IHEAD(7) = 194 + IMAGE_SIZE/8

      HEADER(29:30) = #FFFF
      WRITE(LOGICAL_UNIT,'(A30\)') HEADER
C

c Flush the PostScript buffer
      CALL FLPSBU
      WRITE(LUM,1000)
 1000 FORMAT('stroke')
C Close any open gsaves
      DO N = 1,NGSAVE
        WRITE(LUM,*)'grestore'
      END DO
      NGSAVE = 0

C Get anything that is already in the PSFILE, counting the number of bytes
      REWIND (LUM, ERR = 998)
      PS_FILE_LENGTH = 0

C Allow for the cr lf pair at the end of the header
C      PS_FILE_LENGTH = 2
      LINE_NUMBER = 1
   10 CONTINUE
      CALL LABRDC(LINE,LEN,LUM,EREND)
      LINE_NUMBER = LINE_NUMBER + 1
      IF(.NOT. EREND) THEN
        IF(LINE(1:7) .EQ. '%%Bound') THEN
          WRITE(LOGICAL_UNIT, 1003) (BND_BOX(I),I = 1,4)
 1003     FORMAT('%%BoundingBox: ',4I5)
          PS_FILE_LENGTH = PS_FILE_LENGTH + 35 + 2
C        ELSE IF( LINE_NUMBER .EQ. 14) THEN
C          WRITE(LOGICAL_UNIT, 2004) (TRANS(I),I = 1,2)
C 2004     FORMAT(2(F8.1,' mm'),' translate')
C          PS_FILE_LENGTH = PS_FILE_LENGTH + 32 + 2
C        ELSE IF(LINE_NUMBER .EQ. 15) THEN
C          WRITE(LOGICAL_UNIT,*)' 0 Rotate'
C          PS_FILE_LENGTH = PS_FILE_LENGTH + 9 + 2
        ELSE
          WRITE(LOGICAL_UNIT,'(80A1)') (LINE(I:I), I = 1,LEN)
          PS_FILE_LENGTH = PS_FILE_LENGTH + LEN + 2
        END IF
        GO TO 10
      ELSE
        BACKSPACE(LUM, ERR = 999)
        EPSI =.TRUE.
      END IF

      WRITE(LOGICAL_UNIT,1001)
 1001 FORMAT('restore')
      WRITE(LOGICAL_UNIT,1002)
 1002 FORMAT('%%Trailer')
      PS_FILE_LENGTH = PS_FILE_LENGTH + 16 + 4

C The following lines are commented out because MS WORD can't recognize the
c atend keyword in the PostScript file
C     Write the bounding box data To the PostScript file.
C      WRITE(LOGICAL_UNIT, 1003) (BND_BOX(I),I = 1,4)
c 1003 FORMAT('%%BoundingBox: ',4I5)
C      PS_FILE_LENGTH = PS_FILE_LENGTH + 35 + 2

      WRITE(LOGICAL_UNIT,1005)
 1005 FORMAT('%EOF')
      PS_FILE_LENGTH = PS_FILE_LENGTH + 4 + 2
      CLOSE(LOGICAL_UNIT)

      CALL MG_MAKE_TIFF(FILE_NAME, TIFF_FILE_SIZE)

C Re-open the EPSI file to rewrite the header with the correct PostScript
c and TIFF file lengths.
      IHEAD(3) = PS_FILE_LENGTH
      IHEAD(6) = IHEAD(2) + IHEAD(3) + 2
      IHEAD(7) = TIFF_FILE_SIZE       ! + #FFFF0000
      OPEN(LOGICAL_UNIT, FILE=JobPath(1:LENG)//FILE_NAME, RECL = 30,
     *FORM = 'BINARY', ACCESS = 'DIRECT')
      WRITE(LOGICAL_UNIT, REC = 1) HEADER
      CLOSE(LOGICAL_UNIT)
      EPSI = .FALSE.
      LU = LUM
      RETURN
  998 CONTINUE
      CALL DISPLY(5)
      WRITE(1,*)' COULD NOT REWIND THE PSFILE'
  999 CONTINUE
      CALL DISPLY(5)
      WRITE(1,*)' COULD NOT BACKSPACE THE PSFILE'
      RETURN
      END
